{
  "ReverseProxy": {
    "Routes": [
      {
        "RouteId": "route1",
        "ClusterId": "cluster1",
        "Match": {
          "Path": "/strict/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Metadata": {
          "RateLimitPolicy": "strict"
        }
      },
      {
        "RouteId": "route2",
        "ClusterId": "cluster2",
        "Match": {
          "Path": "/moderate/{**catch-all}",
          "Methods": [ "POST" ]
        },
        "Metadata": {
          "RateLimitPolicy": "moderate"
        }
      },
      {
        "RouteId": "route3",
        "ClusterId": "cluster3",
        "Match": {
          "Path": "/balanced/{**catch-all}",
          "Methods": [ "PUT" ]
        },
        "Metadata": {
          "RateLimitPolicy": "balanced"
        }
      },
      {
        "RouteId": "route4",
        "ClusterId": "cluster4",
        "Match": {
          "Path": "/relaxed/{**catch-all}",
          "Methods": [ "DELETE" ]
        },
        "Metadata": {
          "RateLimitPolicy": "relaxed"
        }
      },
      {
        "RouteId": "route5",
        "ClusterId": "cluster5",
        "Match": {
          "Path": "/unlimited/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "DELETE" ]
        },
        "Metadata": {
          "RateLimitPolicy": "unlimited"
        }
      }
    ],
    "Clusters": [
      {
        "ClusterId": "cluster1",
        "Destinations": {
          "d1": { "Address": "https://example.com/strict/" }
        }
      },
      {
        "ClusterId": "cluster2",
        "Destinations": {
          "d1": { "Address": "https://example.com/moderate/" }
        }
      },
      {
        "ClusterId": "cluster3",
        "Destinations": {
          "d1": { "Address": "https://example.com/balanced/" }
        }
      },
      {
        "ClusterId": "cluster4",
        "Destinations": {
          "d1": { "Address": "https://example.com/relaxed/" }
        }
      },
      {
        "ClusterId": "cluster5",
        "Destinations": {
          "d1": { "Address": "https://example.com/unlimited/" }
        }
      }
    ]
  },
  "RateLimiting": {
    "Policies": {
      "strict": {
        "PermitLimit": 2,
        "Window": "00:00:10",
        "QueueLimit": 0,
        "QueueProcessingOrder": "OldestFirst"
      },
      "moderate": {
        "PermitLimit": 5,
        "Window": "00:00:30",
        "QueueLimit": 2,
        "QueueProcessingOrder": "OldestFirst"
      },
      "balanced": {
        "PermitLimit": 10,
        "Window": "00:01:00",
        "QueueLimit": 5,
        "QueueProcessingOrder": "OldestFirst"
      },
      "relaxed": {
        "PermitLimit": 20,
        "Window": "00:02:00",
        "QueueLimit": 10,
        "QueueProcessingOrder": "OldestFirst"
      },
      "unlimited": {
        "PermitLimit": 1000,
        "Window": "00:10:00",
        "QueueLimit": 100,
        "QueueProcessingOrder": "OldestFirst"
      }
    }
  }
}
