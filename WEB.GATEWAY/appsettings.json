{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:3000",
      "http://localhost:3000"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {ClientIP} {HostName} {RequestPath} {CorrelationId} {TraceId} {SpanId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithExceptionDetails",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "TurnOffRedisCache": true,
  "Redis": {
    "Host": "localhost", // Replace with your Redis server hostname or IP
    "Port": 6379, // Default Redis port
    "Username": "your-username", // Optional, if Redis requires a username
    "Password": "your-password", // Optional, if Redis requires a password
    "KeyPrefix": "gateway-cache", // Optional, used to namespace keys
    "UseSsl": false, // Set to "true" if using SSL
    "SyncTimeout": 5000 // Timeout in milliseconds
  },
  "OutputCache": {
    "Policies": {
      "ShortTerm": {
        "Duration": "00:01:00"
      },
      "LongTerm": {
        "Duration": "00:10:00"
      }
    }
  },
  "RateLimiting": {
    "Policies": {
      "blocked": {
        "PolicyName": "blocked",
        "PermitLimit": 0,
        "WindowSeconds": 10,
        "QueueLimit": 0,
        "QueueProcessingOrder": "OldestFirst"
      },
      "strict": {
        "PolicyName": "strict",
        "PermitLimit": 2,
        "WindowSeconds": 10,
        "QueueLimit": 0,
        "QueueProcessingOrder": "OldestFirst"
      },
      "moderate": {
        "PolicyName": "moderate",
        "PermitLimit": 5,
        "WindowSeconds": 30,
        "QueueLimit": 2,
        "QueueProcessingOrder": "OldestFirst"
      },
      "balanced": {
        "PolicyName": "balanced",
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 5,
        "QueueProcessingOrder": "OldestFirst"
      },
      "relaxed": {
        "PolicyName": "relaxed",
        "PermitLimit": 20,
        "WindowSeconds": 120,
        "QueueLimit": 10,
        "QueueProcessingOrder": "OldestFirst"
      },
      "unlimited": {
        "PolicyName": "unlimited",
        "PermitLimit": 1000,
        "WindowSeconds": 600,
        "QueueLimit": 100,
        "QueueProcessingOrder": "OldestFirst"
      }
    }
  },
  "Gateway": {
    "QueryKey": "path",
    "TransformQueryKey": "keyName",
    "ApiPath": "/gateway-api/api/gateway",
    "RoutePathByKey": "/api/v1/gateway/getgatewayurlbykey"
  },
