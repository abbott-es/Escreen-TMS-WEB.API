{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {ClientIP} {HostName} {RequestPath} {CorrelationId} {TraceId} {SpanId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithExceptionDetails", "WithMachineName", "WithThreadId" ]
  },

  "RateLimiting": {
    "Policies": {
      "blocked": {
        "PolicyName": "blocked",
        "PermitLimit": 0,
        "Window": "00:00:10",
        "QueueLimit": 0,
        "QueueProcessingOrder": "OldestFirst"
      },
      "strict": {
        "PolicyName": "strict",
        "PermitLimit": 2,
        "Window": "00:00:10",
        "QueueLimit": 0,
        "QueueProcessingOrder": "OldestFirst"
      },
      "moderate": {
        "PolicyName": "moderate",
        "PermitLimit": 5,
        "Window": "00:00:30",
        "QueueLimit": 2,
        "QueueProcessingOrder": "OldestFirst"
      },
      "balanced": {
        "PolicyName": "balanced",
        "PermitLimit": 10,
        "Window": "00:01:00",
        "QueueLimit": 5,
        "QueueProcessingOrder": "OldestFirst"
      },
      "relaxed": {
        "PolicyName": "relaxed",
        "PermitLimit": 20,
        "Window": "00:02:00",
        "QueueLimit": 10,
        "QueueProcessingOrder": "OldestFirst"
      },
      "unlimited": {
        "PolicyName": "unlimited",
        "PermitLimit": 1000,
        "Window": "00:10:00",
        "QueueLimit": 100,
        "QueueProcessingOrder": "OldestFirst"
      }
    }
  },

  "ReverseProxy": {
    "Routes": [
      {
        "RouteId": "route1",
        "ClusterId": "cluster1",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "strict"
        }
      },
      {
        "RouteId": "route2",
        "ClusterId": "cluster2",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "balanced"
        }
      }
    ],
    "Clusters": [
      {
        "ClusterId": "cluster1",
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7263/"
          }
        }
      },
      {
        "ClusterId": "cluster2",
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5003/"
          }
        }
      }
    ]
  }
}
