{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {ClientIP} {HostName} {RequestPath} {CorrelationId} {TraceId} {SpanId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithExceptionDetails",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "OutputCache": {
    "Policies": {
      "ShortTerm": {
        "Duration": "00:01:00"     
      },
      "LongTerm": {
        "Duration": "00:10:00"       
      }
    }
  },
  "RateLimiting": {
    "Policies": {
      "blocked": {
        "PolicyName": "blocked",
        "PermitLimit": 0,
        "WindowSeconds": 10,
        "QueueLimit": 0,
        "QueueProcessingOrder": "OldestFirst"
      },
      "strict": {
        "PolicyName": "strict",
        "PermitLimit": 2,
        "WindowSeconds": 10,
        "QueueLimit": 0,
        "QueueProcessingOrder": "OldestFirst"
      },
      "moderate": {
        "PolicyName": "moderate",
        "PermitLimit": 5,
        "WindowSeconds": 30,
        "QueueLimit": 2,
        "QueueProcessingOrder": "OldestFirst"
      },
      "balanced": {
        "PolicyName": "balanced",
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 5,
        "QueueProcessingOrder": "OldestFirst"
      },
      "relaxed": {
        "PolicyName": "relaxed",
        "PermitLimit": 20,
        "WindowSeconds": 120,
        "QueueLimit": 10,
        "QueueProcessingOrder": "OldestFirst"
      },
      "unlimited": {
        "PolicyName": "unlimited",
        "PermitLimit": 1000,
        "WindowSeconds": 600,
        "QueueLimit": 100,
        "QueueProcessingOrder": "OldestFirst"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "route2": {
        "ClusterId": "cluster2",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "balanced"
        }
      },
      "authentication-api-create-auth-route": {
        "ClusterId": "authentication-api-cluster",
        "RateLimiterPolicy": "strict",
        "Match": {
          "Path": "/authentication-api/api/sso/authentication/create-auth",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/v1/authentication/create-auth"
          }
        ],
        "Metadata": {
        }
      },
      "authentication-api-login-route": {
        "ClusterId": "authentication-api-cluster",
        "RateLimiterPolicy": "balanced",
        "Match": {
          "Path": "/authentication-api/api/sso/authentication/login",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/v1/authentication/login"
          }
        ],
        "Metadata": {
        }
      },
      "authentication-api-refresh-token-route": {
        "ClusterId": "authentication-api-cluster",
        "RateLimiterPolicy": "balanced",
        "Match": {
          "Path": "/authentication-api/api/sso/authentication/refresh-token",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/v1/authentication/refresh-token"
          }
        ],
        "Metadata": {
        }
      },
      "authentication-api-revoke-route": {
        "ClusterId": "authentication-api-cluster",
        "RateLimiterPolicy": "balanced",
        "Match": {
          "Path": "/authentication-api/api/sso/authentication/revoke",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/v1/authentication/revoke"
          }
        ],
        "Metadata": {
        }
      },
      "authentication-api-logout-route": {
        "ClusterId": "authentication-api-cluster",
        "RateLimiterPolicy": "balanced",
        "Match": {
          "Path": "/authentication-api/api/sso/authentication/logout",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/v1/authentication/logout"
          }
        ],
        "Metadata": {
        }
      },
      "authentication-api-session-route": {
        "ClusterId": "authentication-api-cluster",
        "RateLimiterPolicy": "balanced",
        "Match": {
          "Path": "/authentication-api/api/sso/session",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/v1/session"
          }
        ],
        "Metadata": {
        }
      },
      "authentication-api-keep-alive-route": {
        "ClusterId": "authentication-api-cluster",
        "RateLimiterPolicy": "balanced",
        "Match": {
          "Path": "/authentication-api/api/sso/session/keep-alive",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/v1/session/keep-alive"
          }
        ],
        "Metadata": {
        }
      },
      "authentication-api-create-session-route": {
        "ClusterId": "authentication-api-cluster",
        "RateLimiterPolicy": "balanced",
        "Match": {
          "Path": "/authentication-api/api/sso/session/create-session",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
        }
      }
    },
    "Clusters": {
      "authentication-api-cluster": {
        "ClusterId": "authentication-api-cluster",
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7263"
          },
          "destination2": {
            "Address": "http://localhost:5046"
          }
        }
      },
      "cluster2": {
        "ClusterId": "cluster2",
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5003/"
          }
        }
      }
    }
  }
}