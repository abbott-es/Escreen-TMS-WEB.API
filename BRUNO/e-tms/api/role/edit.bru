meta {
  name: edit
  type: http
  seq: 3
}

put {
  url: {{BASE_URL}}/role-api/api/role?id={{RoleId}}
  body: json
  auth: inherit
}

params:query {
  id: {{RoleId}}
  ~Includes: {{Includes}}
}

body:json {
  {
    "roleId": "{{RoleId}}",
    "roleName": "string"
  }
}

vars:pre-request {
  RoleId: roleid
  Includes: incl
}

settings {
  encodeUrl: true
}
