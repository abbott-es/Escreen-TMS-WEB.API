meta {
  name: edit
  type: http
  seq: 5
}

put {
  url: {{BASE_URL}}/vehicle-api/api/vehicle?Includes={{Includes}}&Id={{VehicleId}}
  body: json
  auth: inherit
}

params:query {
  Includes: {{Includes}}
  Id: {{VehicleId}}
}

body:json {
  {
    "vehicleID": "{{VehicleId}}",
    "model": "string",
    "plateNumber": "string",
    "chassis": {
      "chassisID": "{{ChassisId}}",
      "vehicleID": "{{VehicleId}}",
      "type": "string",
      "serialNumber": "string"
    }
  }
}

vars:pre-request {
  Includes: PropertyToUpdate
  VehicleId: vehicle
  ChassisId: chassis
}

settings {
  encodeUrl: true
}

docs {
  edit vehicle
}
