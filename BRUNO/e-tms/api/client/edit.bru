meta {
  name: edit
  type: http
  seq: 5
}

put {
  url: {{BASE_URL}}/client-api/api/client?Includes={{Includes}}&Id={{ClientId}}
  body: json
  auth: inherit
}

params:query {
  Includes: {{Includes}}
  Id: {{ClientId}}
}

body:json {
  {
    "clientId": "{{ClientId}}",
    "companyName": "brother",
    "user": {
      "roleID": "{{roleId}}",
      "userInfo": {
        "firstName": "string",
        "lastName": "string",
        "email": "string",
        "contactNumber": "string",
        "licenseNumber": "string"
      },
      "auth": {
        "username": "string",
        "password": "string"
      }
    },
    "locations": [
      {
        "name": "string",
        "address": "string",
        "type": "string"
      }
    ]
  }
}

vars:pre-request {
  Includes: PropertyToUpdate
  ClientId: clientId
  roleId: roleId
}

settings {
  encodeUrl: true
}

docs {
  Edit client data with their new client info with includes pass required parameter to update
}
