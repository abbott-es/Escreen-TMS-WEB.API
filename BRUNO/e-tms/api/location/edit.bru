meta {
  name: edit
  type: http
  seq: 4
}

put {
  url: {{BASE_URL}}/location-api/api/location?id={{LocationId}}
  body: json
  auth: inherit
}

params:query {
  id: {{LocationId}}
}

body:json {
  {
    "locationID": "{{LocationId}}",
    "name": "string",
    "address": "string",
    "type": "string",
    "clientID": "guid"
  }
}

vars:pre-request {
  LocationId: location
}

settings {
  encodeUrl: true
}
