meta {
  name: create-auth
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/authentication-api/api/authentication/create-auth
  body: json
  auth: inherit
}

body:json {
  {
    "RoleID": "guid" ,
    "Auth" :{
    "Username": "user",
    "Password": "pass"
    } , 
    "UserInfo" : { 
      "FirstName" : "first",
      "LastName" : "last",
      "Email" : "email@test.com",
      "ContactNumber": "0"
    }
  }
}

settings {
  encodeUrl: true
}
